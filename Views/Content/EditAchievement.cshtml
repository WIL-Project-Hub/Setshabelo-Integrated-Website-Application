@model SetshabeloAdmissionSystem.ViewModels.EditAchievementViewModel

@{
    ViewData["Title"] = "Edit Achievement";
}

<style>
    .edit-achievement-page {
        max-width: 800px;
        margin: 0 auto;
    }

    .page-heading {
        color: #1b4d3e;
        font-weight: 700;
    }

    .page-subtitle {
        color: #6c7b73;
        margin-bottom: 25px;
    }

    .achievement-form-card {
        background: white;
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 18px rgba(27, 77, 62, 0.12);
    }

    .form-card-header {
        background: linear-gradient(135deg, #1b4d3e, #28745a);
        color: white;
        padding: 22px 28px;
    }

        .form-card-header h4 {
            margin: 0;
            font-weight: 700;
        }

    .form-card-body {
        padding: 28px;
    }

    .form-label {
        display: block;
        color: #1b4d3e;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .form-control {
        border: 1px solid #cedbd2;
        border-radius: 8px;
        padding: 11px 13px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .form-control:focus {
            border-color: #28745a;
            box-shadow: 0 0 0 0.2rem rgba(40, 116, 90, 0.15);
        }

    textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    input[type="file"].form-control {
        padding: 8px;
        background: #f8fbf8;
    }

    input[type="file"]::file-selector-button {
        background: #e5f0e8;
        color: #1b4d3e;
        border: 1px solid #c8dccd;
        border-radius: 6px;
        padding: 7px 12px;
        margin-right: 12px;
        font-weight: 600;
        cursor: pointer;
    }

        input[type="file"]::file-selector-button:hover {
            background: #d5e8da;
        }

    .current-image-panel {
        background: #f4f8f5;
        border: 1px solid #e1ebe4;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 20px;
    }

    .current-image-label {
        color: #1b4d3e;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .current-image {
        display: block;
        max-width: 100%;
        max-height: 220px;
        object-fit: contain;
        border-radius: 8px;
        background: white;
        box-shadow: 0 2px 8px rgba(27, 77, 62, 0.12);
    }

    .upload-help {
        display: block;
        color: #6c7b73;
        font-size: 0.875rem;
        margin-top: 8px;
    }

    .validation-summary-errors {
        background: #fff1f1;
        border: 1px solid #f0caca;
        color: #b42332;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
    }

        .validation-summary-errors ul {
            margin-bottom: 0;
            padding-left: 20px;
        }

    .field-validation-error {
        display: block;
        font-size: 0.875rem;
        margin-top: 5px;
    }

    .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #e4ece6;
    }

    .btn-save {
        background: #1b4d3e;
        color: white;
        border: 1px solid #1b4d3e;
        border-radius: 8px;
        padding: 10px 22px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .btn-save:hover {
            background: #14392e;
            border-color: #14392e;
            color: white;
        }

    .btn-cancel {
        background: white;
        color: #1b4d3e;
        border: 1px solid #1b4d3e;
        border-radius: 8px;
        padding: 10px 22px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-cancel:hover {
            background: #eaf2ec;
            color: #14392e;
        }

    @@media (max-width: 576px) {
        .form-card-header,
        .form-card-body {
            padding: 20px;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn-save,
        .btn-cancel {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="edit-achievement-page">
    <h2 class="page-heading">Edit Achievement</h2>
    <p class="page-subtitle">
        Update the achievement details and image below.
    </p>

    <div class="achievement-form-card">
        <div class="form-card-header">
            <h4>Achievement Information</h4>
        </div>

        <div class="form-card-body">
            <form asp-action="EditAchievement"
                  method="post"
                  enctype="multipart/form-data">

                <input type="hidden" asp-for="AchievementId" />
                <input type="hidden" asp-for="ExistingImageUrl" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="mb-4">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Enter achievement title" />
                    <span asp-validation-for="Title"
                          class="text-danger field-validation-error"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Describe the achievement..."></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger field-validation-error"></span>
                </div>

                <div class="mb-3">
                    @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                    {
                        <div class="current-image-panel">
                            <label class="current-image-label">
                                Current Image
                            </label>

                            <img src="@Model.ExistingImageUrl"
                                 alt="Current achievement image"
                                 class="current-image" />
                        </div>
                    }

                    <label asp-for="ImageFile" class="form-label">
                        Replace Image (Optional)
                    </label>

                    <input asp-for="ImageFile"
                           type="file"
                           accept="image/*"
                           class="form-control" />

                    <small class="upload-help">
                        Leave this empty to keep the current image.
                    </small>

                    <span asp-validation-for="ImageFile"
                          class="text-danger field-validation-error"></span>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-save">
                        Save Changes
                    </button>

                    <a asp-action="ManageContent" class="btn-cancel">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
